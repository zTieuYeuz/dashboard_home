# Claude Code worktrees & local settings
.claude/

# Wrangler local cache
.wrangler/

# Node modules (nếu sau này thêm)
node_modules/

# ── Local-only folders (KHÔNG lên GitHub) ──
# Sắp xếp 2026-07-01: gom file lộn xộn ở root vào 3 thư mục.
# Cloudflare chỉ build từ: worker.js + public/ + wrangler.toml (đều ở root).
#   _docs/  = NOTES, HANDOVER, TEST_PLAN, GIT_BRANCHING_GUIDE, tài liệu bàn giao
#   _infra/ = docker/, n8n-workflows/, frigate-config-ai.yml — hạ tầng, credentials
#   _tools/ = scripts one-off (generate_test_xlsx.py...)
_docs/
_infra/
_tools/

# Env files / local secrets — never commit
.env
.env.local
.dev.vars
.dev.vars.*
*.secret
import-secrets.ps1
sp_tmp.json
dev_tmp.json
wrangler.staging.toml

# ── Defense-in-depth: chặn theo tên kể cả khi file bị tạo lại ở root ──
NOTES.md
HANDOVER.md
GIT_BRANCHING_GUIDE.md
TEST_PLAN.md
TEST_PLAN_Movi_Dashboard.xlsx
generate_test_xlsx.py
frigate-config.yml
frigate-config-ai.yml
RUSTDESK-GUIDE.md
scrypted-docker-compose.yaml
docker/
n8n/
n8n-workflows/
docs/

# ── Bổ sung 2026-07-27 ──
# Rác biên dịch Python (file .pyc từng lọt lên GitHub)
__pycache__/
*.py[cod]

# Bộ kiểm tra tự động — chạy tại máy, không cần lên GitHub
_selftest/

# Rác hệ điều hành / trình soạn thảo
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Bộ cài dash-ssh (23 MB) — deploy lên Cloudflare từ máy anh Thoại, KHÔNG commit
# vào git cho khỏi phình repo. Dựng lại bằng: cd _infra/dash-ssh && npm run build
public/downloads/*.exe
public/downloads/*.zip

# ── Rac cua Google Drive (bo sung 2026-08-28) ──────────────────────────────
# Thu muc Documents cua may DANG duoc Google Drive sao luu, ma repo nam trong
# do. Drive rai file rieng cua no vao moi thu muc no cham toi.
#
# desktop.ini: Windows/Drive tao de dat icon cho thu muc. KHONG phai file cua
# du an — nhung no DA TUNG LOT len GitHub that (commit 7530cfb, 27/08/2026),
# vi luc do gitignore chua co dong nay.
#
# .tmp.driveupload: file dang tai len do dang. Truoc day dong nay bi ghi LAP
# hai lan — da gop lai con mot.
desktop.ini
Desktop.ini
.tmp.driveupload/
.tmp.drivedownload/
*.gdoc
*.gsheet
*.gslides
*.gdraw
*.gform
*.gmap
*.gsite

# ── Bo sung 2026-08-21 ──
# Phong ho: file sao luu KV chua hash mat khau + khoa MFA. Chung nam o
# ..\dashboard_backup\ (NGOAI repo) nen binh thuong git khong thay. Dong nay
# chan truong hop ai do chep nham vao trong repo.
dashboard_backup/
backups/
*.json.enc
